# Question_DB backend (Rust API) — LOCAL development defaults.
# Used when running the binary directly with `cargo run` (NOT docker compose).
#
# For docker compose deployment, use compose.prod.env.example instead.

# Postgres connection (point at a local instance, e.g. the compose db port-forwarded to 5432).
QB_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/qb
QB_BIND_ADDR=127.0.0.1:8080
QB_EXPORT_DIR=./exports
QB_OBJECT_STORE_DIR=./objects
QB_MAX_DB_CONNECTIONS=10
QB_CORS_ORIGINS=http://localhost:5173
QB_JWT_SECRET=qb-dev-secret-change-me-in-production
