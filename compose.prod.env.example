# Question_DB backend (Rust API) — Docker Compose production defaults.
# Copy to `.env` (or pass --env-file) and edit the secrets.
#
# Variable names are shared with Question_DB_Dashboard so the same `.env`
# layout works for both the api-only stack (this repo) and the full
# db+api+web stack (the dashboard repo).

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_DB=qb
POSTGRES_USER=qb
POSTGRES_PASSWORD=change-this-password
QB_POSTGRES_MAJOR=16

# ── Backend (API) ───────────────────────────────────
# QB_DATABASE_URL must use the SAME password as POSTGRES_PASSWORD.
QB_DATABASE_URL=postgres://qb:change-this-password@db:5432/qb
QB_JWT_SECRET=change-this-to-a-long-random-string
QB_API_PORT=8080
QB_MAX_DB_CONNECTIONS=20
QB_EXPORT_DIR=/var/lib/qb/exports
QB_OBJECT_STORE_DIR=/var/lib/qb/objects
QB_CORS_ORIGINS=https://your-frontend.example.com

# ── Images ──────────────────────────────────────────
QB_API_IMAGE=qb_api
QB_API_TAG=latest
